[user]
    name = Robin Edmunds
    email = 8656189+robinedmunds@users.noreply.github.com
[core]
    whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
    excludesfile = ~/.gitignore
    pager = delta
    # sshCommand = 'C:\\Windows\\System32\\OpenSSH\\ssh.exe'
[color]
    ui = auto
[gitlab]
    user = Robin-Edmunds
    email = 30272968-Robin-Edmunds@users.noreply.gitlab.com
[github]
    user = robinedmunds
    email = 8656189+robinedmunds@users.noreply.github.com
[alias]
    aslog = log --oneline --graph --all -n20
    asloga = log --oneline --graph --all
    slog = log --oneline
    a = add --all
    ai = add -i
    b = branch
    ba = branch -a
    bd = branch -d
    bdd = branch -D
    br = branch -r
    cm = commit -m
    cam = commit -am
    cp = cherry-pick
    d = diff
    ls = ls-files
    lsf = !git ls-files | grep -i
    m = merge
    o = checkout
    ob = checkout -b
    r = remote
    s = status
    t = tag
    td = tag -d
    aliases = !git config -l | grep alias | cut -c 7-
[clone]
    defaultRemoteName = remote
[init]
    defaultBranch = main
[pull]
    rebase = false
[fetch]
    prune = true
[include]
    path = ./themes.gitconfig
[delta]
    dark = true
    syntax-theme = Dracula
    hyperlinks = true
    line-numbers = true
    side-by-side = true
    true-color = always
